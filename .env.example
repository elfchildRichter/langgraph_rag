# =====================================================================
# LangGraph Adaptive & Corrective RAG (CRAG) 系統環境變數設定範例檔
# =====================================================================

# 1. 預設 LLM 提供者 (選填: "ollama" 或 "google"，預設: "ollama")
LLM_PROVIDER=ollama

# 2. Ollama 遠端 / 本地伺服器設定 (Ollama Configuration)
# 遠端伺服器位址或本地 http://localhost:11434
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_EMBED_MODEL=nomic-embed-text

# 3. Google Gemini API 設定 (Google Gemini Configuration)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-3.6-flash
GOOGLE_EMBED_MODEL=models/gemini-embedding-001

# 4. 後端服務與 JWT 認證安全密鑰 (Security & Auth)
JWT_SECRET_KEY=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_DAILY_LIMIT=20
BACKEND_URL=http://localhost:8000

# 5. 系統預設管理員帳號設定 (Configurable Admin Accounts)
# 支援多名單語法：
# 方式 A (使用者名單): ADMIN_USERS="admin, manager" 搭配 DEFAULT_ADMIN_PASSWORD
# 方式 B (專屬密碼): ADMIN_USERS="admin:admin123,superadmin:SuperPass888"
ADMIN_USERS="admin, manager"
DEFAULT_ADMIN_PASSWORD="your_secure_password_here"
